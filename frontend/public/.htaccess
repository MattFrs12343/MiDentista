# Redirección para aplicación de una sola página (SPA).
#
# El contenido que se sube por FTP a HostGator es `dist/`, que incluye este
# archivo. Sin estas reglas, recargar una ruta interna como /app/pacientes
# devuelve 404, porque Apache busca ese archivo en disco y no existe.
#
# Especificación: docs/ARCHITECTURE.md §9.2

<IfModule mod_rewrite.c>
    RewriteEngine On

    # No reescribir si el archivo o el directorio existen de verdad.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Todo lo demás se resuelve desde index.html.
    RewriteRule ^ index.html [L]
</IfModule>