# Copia este archivo a .env y ajusta los valores si quieres cambiar los
# valores por defecto usados por docker-compose.yml.

POSTGRES_DB=midentista
POSTGRES_USER=midentista
POSTGRES_PASSWORD=midentista
POSTGRES_PORT=5432

FRONTEND_PORT=8080

# Configuración del frontend: copiar estas variables a frontend/.env.local.
# Completar con la URL y clave pública reales del proyecto Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
