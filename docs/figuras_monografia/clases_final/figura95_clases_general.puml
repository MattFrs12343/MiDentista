  + expira_en: TIMESTAMPTZ
  + usado: BOOLEAN?
}
class "Paciente\n<size:12>«table: pacientes»</size>" as pacientes {
  + id: UUID {PK}
  + clinica_id: UUID {FK}
  + perfil_id: UUID? {FK}
  + nombre_completo: TEXT
  + ci: TEXT?
  + telefono: TEXT?
  + activo: BOOLEAN?
}
class "Servicio\n<size:12>«table: servicios»</size>" as servicios {
  + id: UUID {PK}
  + clinica_id: UUID {FK}
