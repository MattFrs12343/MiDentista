' Modelo derivado de SQL versionado; no afirma introspección ni instalación remota.
' Cada Fnn identifica UNA restricción física; las FK compuestas no se fusionan con las simples.
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classFontSize 14
skinparam classAttributeFontSize 13
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classBorderColor #303030
skinparam classFontColor black
skinparam ArrowColor #555555
skinparam ArrowFontColor black
skinparam ArrowFontSize 12
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 80
skinparam padding 5
hide circle
hide empty methods
top to bottom direction
class "Clinica\n<size:12>«table: clinicas»</size>" as clinicas {
  + id: UUID {PK}
  + nombre: TEXT
  + slug: TEXT {UQ}
  + moneda: TEXT?
  + activo: BOOLEAN?
}
class "Perfil\n<size:12>«table: perfiles»</size>" as perfiles {
  + id: UUID {PK}
  + clinica_id: UUID? {FK}
  + auth_user_id: UUID? {FK}
  + nombre_completo: TEXT
  + rol: TEXT
  + activo: BOOLEAN?
}
class "PerfilRecuperacion\n<size:12>«table: perfiles_recuperacion»</size>" as perfiles_recuperacion {
  + id: UUID {PK}
  + perfil_id: UUID {FK}
