@startuml seq_afiliacion
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam dpi 150
autonumber

title Afiliación de un paciente a su clínica

actor "Paciente" as P
boundary "SPA (React)" as SPA
control "API Supabase" as API
entity "PostgreSQL" as DB

P -> SPA : iniciar sesión o registrarse
activate SPA
SPA -> API : signIn / signUp
activate API
API -->> SPA : JWT de sesión
deactivate API
P -> SPA : buscar clínica por nombre o por cercanía (radio de 5 km)
SPA -> API : consultar clínicas activas
activate API
API -> DB : SELECT clínicas activas
activate DB
DB -->> API : clínicas con latitud y longitud
deactivate DB
API -->> SPA : lista ordenada por distancia (Haversine)
deactivate API
P -> SPA : seleccionar la clínica y confirmar la afiliación
SPA -> API : RPC afiliar_paciente(clinica_id)
activate API
API -> DB : actualizar perfil y crear registro de paciente
activate DB
DB -->> API : afiliación registrada
deactivate DB
API -->> SPA : confirmación de afiliación
deactivate API
SPA -->> P : portal del paciente habilitado
deactivate SPA
@enduml
