@startuml seq_cobro
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam dpi 150
autonumber

title Cobro y registro de un pago con referencia QR estática

actor "Odontólogo / Recepcionista" as O
boundary "SPA (React)" as SPA
entity "PostgreSQL" as DB

O -> SPA : abrir el presupuesto aceptado del paciente
activate SPA
SPA -> DB : SELECT presupuesto y pagos registrados
activate DB
DB -->> SPA : total, pagado y saldo pendiente
deactivate DB
SPA -->> O : estado de cuenta y código QR de cobro
O -> SPA : registrar pago (monto, método y referencia)
SPA -> SPA : validar monto contra el saldo
alt Monto válido
  SPA -> DB : INSERT pagos (estado = confirmado)
  activate DB
  DB -->> SPA : pago registrado
  deactivate DB
  SPA -> DB : UPDATE presupuesto con el nuevo saldo
  activate DB
  DB -->> SPA : saldo actualizado
  deactivate DB
  alt Saldo pendiente igual a cero
    SPA -> DB : UPDATE presupuesto (estado = pagado)
    activate DB
    DB -->> SPA : presupuesto cerrado
    deactivate DB
  end
  SPA -->> O : comprobante de pago y recibo
else Monto superior al saldo
  SPA -->> O : advertencia y solicitud de confirmación
end
deactivate SPA
@enduml
