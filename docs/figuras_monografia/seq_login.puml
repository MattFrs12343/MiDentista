@startuml seq_login
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam dpi 150
autonumber

title Inicio de sesión de un usuario

actor "Usuario" as U
boundary "SPA (React)" as SPA
control "Supabase Auth" as AUTH
entity "PostgreSQL" as DB

U -> SPA : correo electrónico y contraseña
activate SPA
SPA -> AUTH : signInWithPassword(correo, contraseña)
activate AUTH
alt Credenciales válidas
  AUTH -->> SPA : access_token (JWT) + refresh_token
  deactivate AUTH
  SPA -> DB : consultar perfil con el JWT
  activate DB
  DB -> DB : RLS: obtener_clinica_usuario()\ny obtener_rol_usuario()
  DB -->> SPA : perfil filtrado por clínica y rol
  deactivate DB
  SPA -->> U : panel principal según el rol
else Credenciales inválidas
  AUTH -->> SPA : error 400 invalid_credentials
  deactivate AUTH
  SPA -->> U : mensaje «Correo o contraseña incorrectos»
end
deactivate SPA
@enduml
